# Database Configuration
# Local PostgreSQL Docker default (replace with your secure credentials in production/cloud)
DATABASE_URL=postgresql://notes_user:notes_password@localhost:5433/notes_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Configuration (Comma-separated allowed origins; NO WILDCARDS ALLOWED)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
